#!/usr/bin/env bash
# encbench launcher: runs the package without installing anything.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

py=""
for cand in python3 python3.12 python3.11 python3.10 python3.9 python3.8 python; do
  if command -v "$cand" >/dev/null 2>&1; then
    if "$cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3,8) else 1)' 2>/dev/null; then
      py="$cand"; break
    fi
  fi
done

if [ -z "$py" ]; then
  echo "encbench: needs Python 3.8 or newer on PATH." >&2
  echo "  Install it with e.g.: apt install python3 | dnf install python3 | pacman -S python" >&2
  exit 1
fi

export PYTHONPATH="${here}/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$py" -m encbench "$@"
